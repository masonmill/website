# Environment variables for the /climbing/edit GitHub sign-in flow.
# Copy this file to .env.local and fill in real values (never commit real values).
#
# Setup notes:
# 1. Create a GitHub OAuth App at https://github.com/settings/developers
#    ("OAuth Apps" -> "New OAuth App").
# 2. Set "Homepage URL" to your site's origin (e.g. https://example.com).
# 3. Set "Authorization callback URL" to "<your origin>/api/auth/callback"
#    (e.g. http://localhost:3000/api/auth/callback for local dev, and the
#    equivalent https URL for production). You will need a separate OAuth
#    App (and separate client id/secret) per origin you use.
# 4. Copy the generated "Client ID" and a generated "Client secret" below.
# 5. Find your numeric GitHub user id (e.g. via https://api.github.com/users/<your-username>)
#    and set OWNER_GITHUB_ID to it. Only this account can reach /climbing/edit.
# 6. Generate a long random string for SESSION_SECRET, e.g.:
#      openssl rand -hex 32

# GitHub OAuth App client id (not secret, but still don't hardcode it publicly).
GITHUB_OAUTH_CLIENT_ID=

# GitHub OAuth App client secret. Keep this private.
GITHUB_OAUTH_CLIENT_SECRET=

# Random secret used to sign the session cookie (HMAC-SHA256). Rotating this
# value invalidates all existing sessions.
SESSION_SECRET=

# Numeric GitHub user id of the site owner. Only this account is authorized
# to use the /climbing/edit editor.
OWNER_GITHUB_ID=

# Fine-grained GitHub personal access token used by the server to read and
# write data/log.json in masonmill/climbinglog via the Contents API.
# Scope: Contents read/write on masonmill/climbinglog only.
# Create at https://github.com/settings/personal-access-tokens/new
CLIMBINGLOG_GITHUB_PAT=
